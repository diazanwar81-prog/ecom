# Runtime: MOCK | SANDBOX | REAL
ECOM_MODE=MOCK

# Local Docker services
DATABASE_URL=postgresql://ecom:ecom_local_only@localhost:5432/ecom?schema=public
REDIS_URL=redis://localhost:6379

# Application
API_PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Generate unique values locally. Never commit real secrets.
SESSION_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-32-byte-base64-value

# Optional integrations. Keep empty in MOCK mode.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
CJ_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
