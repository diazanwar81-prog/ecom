# Runtime: MOCK | SANDBOX | REAL
ECOM_MODE=MOCK

# Local host access (for tools executed directly on macOS).
DATABASE_URL_HOST=postgresql://ecom:ecom_local_only@localhost:5432/ecom?schema=public
REDIS_URL_HOST=redis://localhost:6379

# Docker services override these internally.
DATABASE_URL=postgresql://ecom:ecom_local_only@postgres:5432/ecom?schema=public
REDIS_URL=redis://redis:6379

# Application
API_PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Generate unique values locally. Never commit real secrets.
SESSION_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-32-byte-base64-value

# Optional integrations. Keep empty in MOCK mode.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
CJ_API_KEY=

# AI Router — budget automático $0. Nunca subir claves al repo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
HF_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Solo para pruebas controladas con claves reales mientras ECOM_MODE=MOCK:
ECOM_AI_FORCE_LIVE=false
# Nunca activar cobros automáticos de IA de pago:
ECOM_ALLOW_PAID_AI=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
