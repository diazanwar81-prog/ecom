# Runtime: MOCK | SANDBOX | REAL
ECOM_MODE=MOCK
# REAL requires explicit confirmation:
# ECOM_REAL_CONFIRM=I_UNDERSTAND_REAL_MODE

DATABASE_URL_HOST=postgresql://ecom:ecom_local_only@localhost:5432/ecom?schema=public
REDIS_URL_HOST=redis://localhost:6379
DATABASE_URL=postgresql://ecom:ecom_local_only@postgres:5432/ecom?schema=public
REDIS_URL=redis://redis:6379

API_PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# For webhooks (phase E): use https:// public URL
# API_URL=https://your-tunnel-or-domain

SESSION_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-32-byte-base64-value

